<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_sky_night"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Top-Right Weather Icon (balances Hero Temp on Top-Left) -->
    <ImageView
        android:id="@+id/widgetIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@null"
        android:src="@drawable/ic_weather_partly_cloudy" />

    <!-- Top-Left Row: City Name + Location Pin -->
    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/widgetIcon"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetLocationPin"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_current_location"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/widgetCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Phong Phú"
            android:textColor="@android:color/white"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Bold Confident Hero Temperature -->
    <TextView
        android:id="@+id/widgetTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widgetHeader"
        android:layout_alignParentStart="true"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:letterSpacing="-0.03"
        android:text="26°"
        android:textColor="@android:color/white"
        android:textSize="46sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#29000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6" />

    <!-- Bottom Info Stack: Condition + Min/Max Range -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Trời nhiều mây"
            android:textColor="#F5FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widgetHighLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="22° / 27°"
            android:textColor="#E0FFFFFF"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

</RelativeLayout>
