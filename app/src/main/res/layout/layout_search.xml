<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <!-- Header: Back Arrow + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_translucent"
            android:padding="10dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/search_cities_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Search Input Pill with Cyan Border -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="#B0BEC5" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="#8CFFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:fontFamily="sans-serif" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="#B3FFFFFF" />
    </LinearLayout>

    <!-- Search Progress Indicator -->
    <ProgressBar
        android:id="@+id/searchProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Results Section Label -->
    <TextView
        android:id="@+id/tvResultsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp"
        android:text="@string/search_results_header"
        android:textColor="#D9FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:fontFamily="sans-serif-medium" />

    <!-- Enclosing Results Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_translucent"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="28dp"
            android:text="@string/no_results"
            android:textColor="#B8FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.01"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </FrameLayout>

</LinearLayout>
