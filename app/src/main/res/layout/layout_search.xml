<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Header: Back Arrow + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_translucent"
            android:padding="9dp"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/search_cities_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Liquid Glass Search Input Capsule -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="11dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="#CCFFFFFF" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="#8CFFFFFF"
            android:textSize="15.5sp"
            android:fontFamily="sans-serif" />

        <!-- Inline Search Progress Indicator -->
        <ProgressBar
            android:id="@+id/searchProgress"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_translucent"
            android:padding="6dp"
            android:contentDescription="Clear search"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Results / Popular Locations Section Label -->
    <TextView
        android:id="@+id/tvResultsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:text="@string/popular_locations_header"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif-medium" />

    <!-- Enclosing Liquid Glass Results Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_translucent"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="28dp"
            android:text="@string/no_results"
            android:textColor="#B8FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.01"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </FrameLayout>

</LinearLayout>
