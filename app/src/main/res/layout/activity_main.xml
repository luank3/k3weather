<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark_teal">

    <!-- Full screen weather effect background -->
    <com.k3weather.app.ui.common.WeatherEffectView
        android:id="@+id/weatherEffectBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ambient Mesh Glow Blob Top-Right -->
    <View
        android:id="@+id/glowBlobTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_circle_translucent"
        android:backgroundTint="#33FBBF24"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ambient Mesh Glow Blob Mid-Left -->
    <View
        android:id="@+id/glowBlobMid"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="200dp"
        android:background="@drawable/bg_circle_translucent"
        android:backgroundTint="#2638BDF8"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Tab Content Area -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Overlay Area -->
    <FrameLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="16dp"
        android:background="#E6071420"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Glassmorphic Bottom Navigation Capsule (Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/bottomNavBar"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginBottom="24dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true"
        android:background="@drawable/bg_nav_glass"
        android:elevation="12dp"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomNavContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Weather / Forecast Tab -->
            <LinearLayout
                android:id="@+id/tabForecast"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_nav_active_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivTabForecast"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#0F172A"
                    android:contentDescription="@string/tab_forecast" />

                <TextView
                    android:id="@+id/tvTabForecast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tab_forecast"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- 2. Saved Cities Tab -->
            <LinearLayout
                android:id="@+id/tabSaved"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivTabSaved"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_saved"
                    app:tint="#B3FFFFFF"
                    android:contentDescription="@string/tab_saved" />

                <TextView
                    android:id="@+id/tvTabSaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tab_saved"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- 3. Settings Tab -->
            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivTabSettings"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="#B3FFFFFF"
                    android:contentDescription="@string/tab_settings" />

                <TextView
                    android:id="@+id/tvTabSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tab_settings"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
