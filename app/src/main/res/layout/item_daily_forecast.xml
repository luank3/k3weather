<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/dayLabel"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dayIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Weather icon" />

        <TextView
            android:id="@+id/dayPop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/minTemperature"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Temperature range bar container -->
    <FrameLayout
        android:id="@+id/temperatureRangeContainer"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_temp_range_track" />

        <View
            android:id="@+id/temperatureRange"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_temp_range_gradient" />

        <View
            android:id="@+id/currentTempDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_circle_translucent"
            android:backgroundTint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/maxTemperature"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
