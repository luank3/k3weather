<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/dayLabel"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <ImageView
        android:id="@+id/dayIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="8dp"
        android:contentDescription="Weather icon" />

    <TextView
        android:id="@+id/minTemperature"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#E0FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Temperature range bar container -->
    <FrameLayout
        android:id="@+id/temperatureRangeContainer"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_temp_range_track" />

        <View
            android:id="@+id/temperatureRange"
            android:layout_width="60dp"
            android:layout_height="5dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_temp_range_gradient" />
    </FrameLayout>

    <TextView
        android:id="@+id/maxTemperature"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
