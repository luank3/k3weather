<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/forecastScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/forecastContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="156dp">

            <!-- TOP HEADER: Quick-Switch City Pills + Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="horizontal"
                    android:fadingEdgeLength="28dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/cityPillsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/searchButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:padding="10dp"
                    android:contentDescription="@string/search_locations"
                    android:src="@drawable/ic_search"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- HERO CURRENT WEATHER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/badgeLocationPill"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/ivLocationPin"
                        android:visibility="gone"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/cityName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Phong Phú"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#38000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8" />

                    <TextView
                        android:id="@+id/citySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="MY LOCATION"
                        android:textAllCaps="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <com.k3weather.app.ui.common.HeroWeatherArtworkView
                    android:id="@+id/heroWeatherArtwork"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:visibility="gone" />

                <!-- Confident Crisp Hero Temperature -->
                <TextView
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="26°"
                    android:textColor="@android:color/white"
                    android:textSize="86sp"
                    android:letterSpacing="-0.03"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:shadowColor="#30000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10" />

                <!-- Single Concise Condition + Range Line -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="U ám"
                        android:textColor="#F5FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#29000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4" />

                    <TextView
                        android:id="@+id/highLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="22° / 27°"
                        android:textColor="#E6FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:shadowColor="#29000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4" />
                </LinearLayout>
            </LinearLayout>

            <!-- HOURLY FORECAST CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_translucent"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvWeatherDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.75dp"
                    android:layout_marginTop="10dp"
                    android:background="#1FFFFFFF" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/hourlyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- MULTI-DAY FORECAST CARD (Chart & List Segmented Toggle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_translucent"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="#99FFFFFF" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/weekly_multi_day"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Segmented Toggle: Chart | List -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_segmented_track"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/btnDailyChart"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_segmented_selected"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="@string/view_chart"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/btnDailyList"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="@string/view_list"
                            android:textColor="#99FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.75dp"
                    android:layout_marginTop="10dp"
                    android:background="#1FFFFFFF" />

                <!-- Dual-Curve Temperature Trend Chart -->
                <HorizontalScrollView
                    android:id="@+id/dailyChartScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fadingEdgeLength="24dp"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <com.k3weather.app.ui.common.DailyTrendChartView
                        android:id="@+id/dailyTrendChart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>

                <!-- Detailed 7-Day Range List -->
                <LinearLayout
                    android:id="@+id/dailyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- COMPACT 3-COLUMN WEATHER METRICS GRID (ROW 1: UV, Feels Like, Humidity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- 1. UV Index Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_uv_sun"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_uv_short"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUvValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="2"
                            android:textColor="@android:color/white"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvUvCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Thấp"
                            android:textColor="#D9FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. Feels Like Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_thermometer"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_feels_short"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvAqiValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="28°"
                        android:textColor="@android:color/white"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 3. Humidity Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_humidity_drop"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_humidity_short"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHumidityValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="81%"
                        android:textColor="@android:color/white"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- COMPACT 3-COLUMN WEATHER METRICS GRID (ROW 2: Wind, Pressure, Visibility) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- 4. Wind Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wind"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:id="@+id/tvWindDirection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Gió Tây Bắc"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvWindValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="13 km/h"
                        android:textColor="@android:color/white"
                        android:textSize="17.5sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 5. Pressure Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_gauge"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_pressure_short"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPressureNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1012 hPa"
                        android:textColor="@android:color/white"
                        android:textSize="17.5sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 6. Visibility Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_card_translucent"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_visibility"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/metric_visibility_short"
                        android:textColor="#99FFFFFF"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvVisibilityValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="14 km"
                        android:textColor="@android:color/white"
                        android:textSize="19.5sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- FULL-WIDTH SUNRISE & SUNSET PROGRESS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_translucent"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sunrise"
                                app:tint="#CCFFFFFF" />

                            <TextView
                                android:id="@+id/tvSunriseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sunrise_short"
                                android:textColor="#99FFFFFF"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSunriseValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:text="05:48"
                            android:textColor="@android:color/white"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSunsetLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="@string/sunset_short"
                                android:textColor="#99FFFFFF"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif" />

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sunrise"
                                app:tint="#CCFFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSunsetValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:text="17:22"
                            android:textColor="@android:color/white"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <com.k3weather.app.ui.common.SolarArcView
                    android:id="@+id/solarArcView"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
