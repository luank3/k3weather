<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_sky_night"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Top Header: Left (Location + Big Temp) | Right (Icon + Condition + High/Low) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Phong Phú"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/widgetLocationPin"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_current_location"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/widgetTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="26°"
                android:textColor="@android:color/white"
                android:textSize="44sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />

            <TextView
                android:id="@+id/widgetCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Trời nhiều mây"
                android:textColor="#F5FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widgetHighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="22° / 27°"
                android:textColor="#E0FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Weather Details Pill Strip (Wind • Humidity • UV / Feels Like) -->
    <TextView
        android:id="@+id/widgetDetailsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Gió Tây Bắc 13 km/h  •  Độ ẩm 82%  •  UV 0"
        android:textColor="#CCFFFFFF"
        android:textSize="11.5sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Divider 1 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#26FFFFFF" />

    <!-- Middle Section: 5-Hour Forecast Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hiện tại"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />
            <TextView
                android:id="@+id/widgetHourTemp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />
            <TextView
                android:id="@+id/widgetHourTemp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider 2 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#26FFFFFF" />

    <!-- Bottom Section: 3-Day Forecast Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Day 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widgetDayLabel1"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Hôm nay"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetDayIcon1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_rain" />
            <TextView
                android:id="@+id/widgetDayPop1"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="84%"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetDayMin1"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="22°"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_temp_range_gradient" />
            <TextView
                android:id="@+id/widgetDayMax1"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="27°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widgetDayLabel2"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Th 7"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetDayIcon2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_rain" />
            <TextView
                android:id="@+id/widgetDayPop2"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetDayMin2"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="22°"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_temp_range_gradient" />
            <TextView
                android:id="@+id/widgetDayMax2"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="28°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widgetDayLabel3"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="CN"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetDayIcon3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />
            <TextView
                android:id="@+id/widgetDayPop3"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="22%"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widgetDayMin3"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="22°"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_temp_range_gradient" />
            <TextView
                android:id="@+id/widgetDayMax3"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="30°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
