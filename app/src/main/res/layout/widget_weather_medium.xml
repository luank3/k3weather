<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_sky_night"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="13dp">

    <!-- Top Half: Left (Location + Big Temp) | Right (Icon + Condition + High/Low) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Phong Phú"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/widgetLocationPin"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_current_location"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/widgetTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:text="25°"
                android:textColor="@android:color/white"
                android:textSize="38sp"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />

            <TextView
                android:id="@+id/widgetCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Trời nhiều mây"
                android:textColor="#F2FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widgetHighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="C:27°  T:22°"
                android:textColor="#D9FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Hairline Glass Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="7dp"
        android:background="#26FFFFFF" />

    <!-- Bottom Half: 5-Hour Forecast Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Hour 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hiện tại"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />
            <TextView
                android:id="@+id/widgetHourTemp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hour 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_partly_cloudy" />
            <TextView
                android:id="@+id/widgetHourTemp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hour 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hour 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hour 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widgetHourTime5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23:00"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widgetHourIcon5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear_night" />
            <TextView
                android:id="@+id/widgetHourTemp5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
