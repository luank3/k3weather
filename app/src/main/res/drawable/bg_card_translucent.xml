<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted sky-tinted glass base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38152940"
                android:endColor="#2E0E1D2F"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Subtle diagonal frost refraction + hairline specular rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#14FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#0EFFFFFF"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="0.75dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <!-- Top edge specular highlight -->
    <item
        android:top="0.8dp"
        android:left="14dp"
        android:right="14dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="0.8dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#45FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
