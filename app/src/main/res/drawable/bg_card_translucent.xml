<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted sky-tinted glass base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3D162B42"
                android:endColor="#330E1E30"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Subtle diagonal frost refraction + hairline specular rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="0.8dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>
    <!-- Top edge specular highlight -->
    <item
        android:top="0.8dp"
        android:left="14dp"
        android:right="14dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="0.8dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#45FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
