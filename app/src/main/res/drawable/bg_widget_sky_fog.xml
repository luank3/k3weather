<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft Atmospheric Pearl-Teal Mist Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F533526B"
                android:centerColor="#F5486A85"
                android:endColor="#F5668BA6"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Frosted Mist Diffused Sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#24E0F2FE"
                android:centerColor="#10FFFFFF"
                android:endColor="#29FFFFFF"
                android:type="linear" />
            <stroke
                android:width="0.9dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
