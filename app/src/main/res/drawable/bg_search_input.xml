<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted Sky-Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4D1A324C"
                android:endColor="#40102236"
                android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Inner Frost Sheen & Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#24FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#127DD3FC"
                android:type="linear" />
            <stroke
                android:width="0.9dp"
                android:color="#47FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
