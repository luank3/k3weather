<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Midnight Atmospheric Gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#051422"
                android:centerColor="#0B2538"
                android:endColor="#0A364C"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Top-Right Dawn Ambient Glow -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="74"
                android:centerY="34"
                android:gradientRadius="55"
                android:startColor="#4538BDF8"
                android:centerColor="#1800E5FF"
                android:endColor="#00051422"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Bottom Deep Horizon Refraction -->
    <path
        android:pathData="M0,72h108v36h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#00020B12"
                android:endColor="#66020B12"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
