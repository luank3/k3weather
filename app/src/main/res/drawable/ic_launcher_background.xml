<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Refractive Liquid Glass Navy Tile -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#0D2538"
                android:centerColor="#071724"
                android:endColor="#040F18"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Liquid Glass Aurora Sheen -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="68"
                android:centerY="38"
                android:gradientRadius="65"
                android:startColor="#3338BDF8"
                android:centerColor="#1000E5FF"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Diagonal Glass Frost Sheen -->
    <path
        android:pathData="M0,0 L108,0 L108,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#1FFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
