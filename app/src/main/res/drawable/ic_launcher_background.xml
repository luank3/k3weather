<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Luminous Apple Sky Blue Canvas Base -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#2D8DF6"
                android:centerColor="#1E75E2"
                android:endColor="#1057BF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Warm Solar Atmospheric Wash in Upper Right -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="74"
                android:centerY="34"
                android:gradientRadius="65"
                android:startColor="#47FFF3B0"
                android:centerColor="#18FFD54F"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Liquid Glass Refractive Diagonal Sheen -->
    <path
        android:pathData="M0,0 L108,0 L108,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#26FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Bottom Horizon Ambient Depth Glow -->
    <path
        android:pathData="M0,72 L108,72 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#00092B60"
                android:endColor="#33061C40"
                android:type="linear" />
        </aapt:attr>
    </path>

</vector>
