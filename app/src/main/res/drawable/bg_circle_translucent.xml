<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#5C0D263A"
                android:endColor="#42071624"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#38FFFFFF"
                android:centerColor="#0EFFFFFF"
                android:endColor="#24FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="6dp"
        android:right="6dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
