<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#540D2538"
                android:endColor="#3D071622"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#2EFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1AFFFFFF"
                android:type="linear" />
