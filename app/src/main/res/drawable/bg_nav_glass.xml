<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E60C1A2B"
                android:centerColor="#D9081320"
                android:endColor="#E60E1E32"
                android:type="linear" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#24FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#17FFFFFF"
                android:type="linear" />
            <corners android:radius="30dp" />
            <stroke
                android:width="0.9dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>
    <item
        android:top="0.8dp"
        android:left="22dp"
        android:right="22dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="0.8dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#66FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
