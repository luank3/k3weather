<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep translucent liquid glass capsule base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#BF091B29"
                android:centerColor="#B306131E"
                android:endColor="#BF0A1F2E"
                android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Frost specular sheen & outer rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#29FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#17FFFFFF"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#42FFFFFF" />
        </shape>
    </item>
    <!-- Top specular highlight along capsule curve -->
    <item
        android:top="1dp"
        android:left="28dp"
        android:right="28dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#73FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
