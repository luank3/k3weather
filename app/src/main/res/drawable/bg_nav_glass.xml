<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep refractive glass base tint with slight cyan-slate undertone -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E6081B28"
                android:centerColor="#D905121C"
                android:endColor="#E6091F2E"
                android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Liquid specular rim and subtle diagonal sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#38FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1FFFFFFF"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4AFFFFFF" />
        </shape>
    </item>
    <!-- Top razor-thin specular highlight curve -->
    <item
        android:top="1dp"
        android:left="24dp"
        android:right="24dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#8AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
