<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Sky Atmosphere Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F2142F4D"
                android:centerColor="#F20D2238"
                android:endColor="#F2081626"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Liquid Glass Specular Rim & Inner Frost Sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#0D7DD3FC"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
