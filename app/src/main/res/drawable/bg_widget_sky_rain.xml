<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stormy Slate-Blue Sky Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F21E334A"
                android:centerColor="#F215263B"
                android:endColor="#F20D1A2B"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Liquid Glass Specular Rim & Inner Frost Sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#1238BDF8"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
