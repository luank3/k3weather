<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stormy Slate-Blue Sky Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F22B4E73"
                android:centerColor="#F23B638C"
                android:endColor="#F24D7AA6"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Liquid Glass Specular Rim & Inner Frost Sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#1238BDF8"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
