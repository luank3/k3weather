<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bright Clear Day Sky Atmosphere Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F2164E8A"
                android:centerColor="#F2226BB3"
                android:endColor="#F23285D1"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Liquid Glass Specular Rim & Inner Frost Sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#29FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#47FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
